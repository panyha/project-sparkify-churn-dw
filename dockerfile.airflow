FROM apache/airflow:3.2.2

USER root
RUN apt-get update && apt-get install -y git && apt-get clean

USER airflow

# dbt for the transform layer, pandas/psycopg2 for loading the JSON event logs
RUN pip install --no-cache-dir \
    dbt-core \
    dbt-postgres \
    astronomer-cosmos \
    pandas \
    psycopg2-binary
